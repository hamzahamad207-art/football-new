{
  "name": "touchline-arabic-bot",
  "version": "2.0.0",
  "description": "Arabic (Khaleeji) soccer bot for Threads — like @TouchlineX but in Arabic.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dry-run": "node src/index.js --dry-run",
    "post:news": "node src/index.js --type news",
    "post:stats": "node src/index.js --type stats",
    "post:analysis": "node src/index.js --type analysis",
    "post:meme": "node src/index.js --type meme",
    "post:throwback": "node src/index.js --type throwback",
    "post:random": "node src/index.js --type random",
    "agent:health": "echo '{\"action\":\"health\"}' | python agents/touchline_agent.py",
    "agent:route": "echo '{\"action\":\"route\",\"type\":\"meme\"}' | python agents/touchline_agent.py",
    "agent:test": "echo '{\"action\":\"verify\",\"caption\":\"FT: برشلونة 2 - 1 ريال مدريد\",\"context\":{\"header\":\"FT: برشلونة 2 - 1 ريال مدريد\",\"topic\":\"El Clasico\"}}' | python agents/touchline_agent.py"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "sharp": "^0.33.4"
  }
}
