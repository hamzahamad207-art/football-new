# ── Copy this file to `.env` for local testing:  cp .env.example .env ──

# OpenRouter API key — get one at https://openrouter.ai/keys  (required)
LLM_API_KEY=

# Model — free frontier-tier open models on OpenRouter (no cost):
#   nvidia/nemotron-3-ultra-550b-a55b:free   ← default, best quality
# (any OpenAI-compatible provider works via LLM_BASE_URL + LLM_MODEL)
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: override the OpenAI-compatible endpoint (default is OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Threads Graph API credentials (only needed with --post / real publishing)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Optional: fixed topic for every run (same as passing --topic)
# BOT_TOPIC=Barça vs Sevilla