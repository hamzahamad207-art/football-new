# ── Copy this file to `.env` for local testing:  cp .env.example .env ──

# Z.ai (GLM) API key — get one at https://z.ai → API Keys  (required)
LLM_API_KEY=

# Model. glm-4.5-flash is the free tier.
# Alternatives: glm-4.7-flash (free), glm-4.6 (paid flagship), glm-5.3 (paid latest)
LLM_MODEL=glm-4.5-flash

# Optional: override the OpenAI-compatible endpoint (default is Z.ai)
# LLM_BASE_URL=https://api.z.ai/api/paas/v4

# Threads Graph API credentials (only needed with --post / real publishing)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Optional: fixed topic for every run (same as passing --topic)
# BOT_TOPIC=Barça vs Sevilla